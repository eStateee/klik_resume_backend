# ==============================================================================
# Django
# ==============================================================================
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False

# Обязательно при DEBUG=False — иначе приложение не стартует.
# Перечислите хосты/IP, по которым открывается сервер (через запятую).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origin'ы фронтенда для CORS. Пусто + DJANGO_CORS_ALLOW_ALL_ORIGINS=False
# означает, что браузерные запросы с других origin'ов запрещены.
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CORS_ALLOW_ALL_ORIGINS=False

# Домены для CSRF (админка). По умолчанию — localhost и ngrok.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com

# Включает SECURE_SSL_REDIRECT, HSTS и Secure-флаг у cookie.
# Ставить True только когда перед приложением есть HTTPS-сертификат.
DJANGO_USE_HTTPS=False

# Число прокси перед Django (nginx = 1) — от него зависит определение
# IP клиента для ограничения частоты запросов.
DJANGO_NUM_PROXIES=1

DJANGO_LOG_LEVEL=INFO

# Префиксы статики/медиа. По умолчанию /static/ — годится, когда бэкенд стоит
# отдельно. Если фронтенд (CRA) отдаётся с того же домена, он занимает /static/
# своими бандлами, поэтому статику Django надо перенести:
# DJANGO_STATIC_URL=/django-static/
# DJANGO_MEDIA_URL=/media/

# Ограничения частоты запросов
THROTTLE_ANON=120/min
THROTTLE_LOGIN=10/min
THROTTLE_REVIEW=20/hour

# ==============================================================================
# PostgreSQL
# ==============================================================================
POSTGRES_DB=klik_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ==============================================================================
# Redis & Celery
# ==============================================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ==============================================================================
# Flower (мониторинг Celery) — http://localhost:5555
# ==============================================================================
# Опционально: базовая аутентификация (логин:пароль)
# FLOWER_BASIC_AUTH=admin:changeme

# ==============================================================================
# CRM (AlfaCRM)
# ==============================================================================
CRM_API_URL=https://demo.alfacrm.pro
CRM_EMAIL=your-crm-email@example.com
CRM_API_KEY=your-crm-api-key
CRM_TOKEN_CACHE_TIMEOUT=3600

# Сколько недель вперёд заглядывать за пределы ближайшей (по умолчанию 2).
CRM_LOOKAHEAD_WEEKS=2
# Длина «дальнего» окна в неделях (по умолчанию 2).
CRM_WINDOW_WEEKS=2

# ==============================================================================
# JWT
# ==============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# ==============================================================================
# S3 Storage (hoster.by) (опционально — если не заданы, используется локальное хранилище)
# ==============================================================================
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_STORAGE_BUCKET_NAME=storage1022
AWS_S3_ENDPOINT_URL=https://storage-1022.s3hoster.by
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
